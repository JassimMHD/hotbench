# Copy to .env and edit. Every value can also be changed live on the page.

# What to read: a camera index (0 = the first webcam), a video file (relative =
# this folder; it loops at its own fps), or an RTSP / HTTP stream URL.
SOURCE=0
# SOURCE=clips/street.mp4
# SOURCE=rtsp://user:PASSWORD@192.168.1.10:554/stream1     # an IP camera (the password is never shown)

# The model: a .pt or .onnx file, or an official Ultralytics name, downloaded on first run.
WEIGHTS=weights/yolo26n.pt
# WEIGHTS=weights/my-model.onnx

# What to detect and count: class names or ids, comma-separated. Empty = every class.
CLASSES=
# CLASSES=person
# CLASSES=car, truck, bus

IMGSZ=640
CONF=0.25
MAX_DET=300

# CPU. THREADS = inference threads. CORES = which cores the whole process may use:
# empty = every core; "0,1" with THREADS=2 shows what a 2-core server would do.
THREADS=4
CORES=

# 0 = infer as fast as the CPU allows; 1 = one inference a second, and so on.
INFER_MAX_FPS=0
INFER_ENABLED=true

# The video in the browser (MJPEG). It costs CPU too, and shows up as "display".
DISPLAY_FPS=10
DISPLAY_WIDTH=1280

# The "median" count is taken over this many seconds.
SMOOTH_SECONDS=30
PORT=8300
